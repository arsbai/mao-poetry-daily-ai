<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_paper">
 <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="向东" android:textSize="13sp" android:textColor="#8f3c34" android:fontFamily="serif"/>
  <TextView android:id="@+id/widget_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="每日一句" android:textSize="10sp" android:textColor="#625e54"/>
  <TextView android:id="@+id/widget_refresh" android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="⟳" android:textSize="19sp" android:textColor="#8f3c34" android:contentDescription="刷新每日一句"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_quote" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="雄关漫道真如铁，\n而今迈步从头越。" android:textColor="#000000" android:fontFamily="serif" android:textSize="23sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="29sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" android:paddingTop="5dp" android:paddingBottom="5dp"/>
 <TextView android:id="@+id/widget_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="忆秦娥·娄山关" android:textColor="#625e54" android:textSize="10sp" android:maxLines="2"/>
</LinearLayout>
